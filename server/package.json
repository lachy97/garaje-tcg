{
  "name": "garage-tcg-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor de cuentas de Garage TCG (Cloudflare Workers + D1)",
  "scripts": {
    "test": "node --test test/api.test.mjs",
    "dev": "wrangler dev",
    "db:init": "wrangler d1 execute garage-tcg --remote --file=migrations/0001_init.sql",
    "deploy": "wrangler deploy",
    "logs": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
